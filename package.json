{
  "name": "@zea.cl/cli",
  "version": "2.1.0",
  "description": "Official CLI and MCP Server for ZEA Platform",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "zea": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "node --test 'src/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=80 'src/**/*.test.js'",
    "audit": "npm audit --production"
  },
  "dependencies": {
    "@zea.cl/cerebelum": "^1.0.0",
    "@zea.cl/cortex": "^1.0.0",
    "@zea.cl/cranium": "^0.2.0",
    "@zea.cl/soma": "^0.2.0",
    "@zea.cl/thalamus": "^1.0.0",
    "chalk": "^5.6.2",
    "commander": "^12.0.0",
    "marked": "^18.0.4",
    "open": "^10.1.0",
    "ora": "^9.4.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6"
  }
}
